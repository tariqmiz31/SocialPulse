# Server Configuration
PORT=5000
NODE_ENV=production
APP_URL=https://silvariumsocial.com

# Security
SECRET_KEY=${SECRET_KEY}
ALLOWED_ORIGINS=https://silvariumsocial.com,https://*.silvariumsocial.com

# Database Configuration
DATABASE_URL=${DATABASE_URL}

# API Keys
OPENAI_API_KEY=${v1.0-ab1ff3a2f6779d1b79893381-292dd1f5afe669d28f9e4ce38fec852fa0c0a44ef0426cb11ad21aff55c76b63e13557638c1d937a008fec4258fc1ebe7a589e1380a47431e47be02c8dcb063a6e4d884211e7fffce5}

# Social Media API Keys
TWITTER_CLIENT_ID=${TWITTER_CLIENT_ID}
TWITTER_CLIENT_SECRET=${TWITTER_CLIENT_SECRET}
INSTAGRAM_CLIENT_ID=${INSTAGRAM_CLIENT_ID}
INSTAGRAM_CLIENT_SECRET=${INSTAGRAM_CLIENT_SECRET}
FACEBOOK_CLIENT_ID=${FACEBOOK_CLIENT_ID}
FACEBOOK_CLIENT_SECRET=${FACEBOOK_CLIENT_SECRET}
TIKTOK_CLIENT_ID=${TIKTOK_CLIENT_ID}
TIKTOK_CLIENT_SECRET=${TIKTOK_CLIENT_SECRET}
YOUTUBE_CLIENT_ID=${YOUTUBE_CLIENT_ID}
YOUTUBE_CLIENT_SECRET=${YOUTUBE_CLIENT_SECRET}
SNAPCHAT_CLIENT_ID=${SNAPCHAT_CLIENT_ID}
SNAPCHAT_CLIENT_SECRET=${SNAPCHAT_CLIENT_SECRET}
PINTEREST_CLIENT_ID=${PINTEREST_CLIENT_ID}
PINTEREST_CLIENT_SECRET=${PINTEREST_CLIENT_SECRET}


# SSL/HTTPS Configuration
SECURE_COOKIES=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# Internationalization
BABEL_DEFAULT_LOCALE=ar

# Custom Domain Settings
CUSTOM_DOMAIN=silvariumsocial.com
CUSTOM_DOMAIN_ENABLED=true